# Public site URL (canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics — consent banner appears only when set
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Lead email via SMTP. Port 587 uses STARTTLS; set SMTP_SECURE=true for port 465.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=leads@your-domain.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=AlliancePay <leads@your-domain.com>
# LEAD_TO_EMAIL=arif1@att.net

# Optional fallback when SMTP is not set (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# LEAD_FROM_EMAIL=AlliancePay Leads <leads@your-verified-domain.com>

# Optional CRM / automation webhook (JSON POST)
# LEAD_WEBHOOK_URL=https://hooks.example.com/alliancepay-leads
# LEAD_WEBHOOK_SECRET=replace-me

# Website assistant — Groq free tier via the OpenAI SDK (server only)
# Create a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxx
# GROQ_MODEL=openai/gpt-oss-120b
